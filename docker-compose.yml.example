version: '3.8'

services:
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: gabi-backend
    ports:
      - "3000:3000"
    environment:
      - PORT=3000
      - NODE_ENV=production
      - NODE_ISLOCAL=true
      - VIDEO_DIR=/app/GABI/Videos
      - THUMB_DIR=/app/GABI/Thumbs
      - TEMP_DIR=/app/Temp
      - AVATAR_DIR=/app/GABI/Avatars
      - DS_SALT=dummy_salt
      - DB_BACKUP_MAIN=/app/backups/main
      - DB_BACKUP_SUB=/app/backups/sub
      - VALID_VIDEO_EXTENSIONS=.mp4,.mkv,.avi,.mov,.wmv,.flv,.webm
      - INVITATION_CODE=dummy_code
      - FRONTEND_ORIGIN=https://dummy.domain.com
      - BACKEND_USE_HTTPS=true
    volumes:
      - ./backend/db:/app/db
      - ./backend/logs:/app/logs
      - ./backend/Temp:/app/Temp
      - ./backend/Backups:/app/backups/main
      - ./backend/cert:/app/cert:ro
      - /dummy/path:/app/GABI
      - /dummy/path:/app/backups/sub
    restart: always

  frontend:
    build:
      context: ./frontend_react
      dockerfile: Dockerfile
    container_name: gabi-frontend
    ports:
      - "80:80"
      - "443:443"
    depends_on:
      - backend
    environment:
      - PORT=80
      - VITE_API_BASE_URL=https://dummy.domain.com/api
    volumes:
      - ./frontend_react/cert:/etc/nginx/certs:ro
    restart: always